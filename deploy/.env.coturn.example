# CoralSend coturn service environment (production)
#
# Notes:
# - Variables marked (required) have no compose default and MUST be set.
# - Variables marked (optional) have a compose default; override only if needed.

# Container image tag (optional; default: coturn/coturn:4.9)
# COTURN_IMAGE=instrumentisto/coturn:latest
COTURN_IMAGE=coturn/coturn:4.9

# ------------------------------------------------------------------------------
# Runtime environment (container runtime)
# ------------------------------------------------------------------------------

# PostgreSQL Settings
POSTGRES_DB=coturn
POSTGRES_USER=coturn
POSTGRES_PASSWORD=7bs9F6RcJnVbXR

# Coturn Settings
# Listening address and port ranges (optional; defaults: 0.0.0.0 / 3478 / 49160 / 49200)
COTURN_LISTENING_IP=0.0.0.0
COTURN_LISTENING_PORT=3478
COTURN_MIN_PORT=49152
COTURN_MAX_PORT=49200

# TURN realm — should match your TURN DNS name (required)
COTURN_REALM=turn.example.com

# Static long-term credentials (required)
COTURN_USER=coralsend
COTURN_PASS=change-me

# Public server IP for relayed candidates (required)
EXTERNAL_IP=203.0.113.10

# STATIC_AUTH_SECRET=SuperSecretKey123
COTURN_SERVER_NAME=turn-fakhimi-prod-01

# Coturn-Admin UI Settings
# DB connection strings are already in docker-compose.yml using env vars
# If you need to change the admin UI port, you can do it here or in docker-compose.yml
ADMIN_PORT=8080 # Example: if you want to map 8080 to a different host port

