# ------------------------------------------------------------------------------
# Build arguments (server image build-time)
# ------------------------------------------------------------------------------

# CoralSend signaling server environment (production)
#
# Notes:
# - Variables marked (required) have no compose default and MUST be set.
# - Variables marked (optional) have a compose default; override only if needed.

# Container image tag (optional; default: ghcr.io/alifakhimi/coralsend-server:latest)
SERVER_IMAGE=ghcr.io/alifakhimi/coralsend-server:latest

# ------------------------------------------------------------------------------
# Runtime environment (container runtime)
# ------------------------------------------------------------------------------

# CoralSend signaling server environment (production)
#
# Notes:
# - Variables marked (required) have no compose default and MUST be set.
# - Variables marked (optional) have a compose default; override only if needed.

# Internal port exposed by the signaling server; also used for healthcheck URL (optional; default: 8080)
SERVER_PORT=8080

# Runtime mode for stricter origin enforcement in signaling server
APP_ENV=production

# Healthcheck timing (optional; defaults: 30s / 5s / 5 / 10s)
SERVER_HEALTHCHECK_INTERVAL=30s
SERVER_HEALTHCHECK_TIMEOUT=5s
SERVER_HEALTHCHECK_RETRIES=5
SERVER_HEALTHCHECK_START_PERIOD=10s

# Signaling security and abuse controls
# Supports exact origins, one-level subdomain wildcards (https://*.example.com),
# and `*` for every valid HTTP(S) origin. Prefer exact origins or restricted
# wildcards in production; `*` emits a startup warning.
ALLOWED_ORIGINS=https://coralsend.example.com,https://app.coralsend.example.com

# Fixed-window signaling rate limit on `/ws` (per client IP)
RATE_LIMIT_WINDOW=60
RATE_LIMIT_MAX_REQUESTS=120
# Only these proxy networks may supply X-Forwarded-For/X-Real-IP. Empty means trust none.
TRUSTED_PROXY_CIDRS=

# Secret for HMAC signing of host tokens (required in production)
# Production startup fails unless this is at least 32 bytes.
HOST_SECRET=change-me-use-strong-random-value
